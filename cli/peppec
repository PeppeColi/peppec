#!/usr/bin/env bash
# PEPPEC command line: installs and checks PEPPEC on a host repository.
# Needs gh (signed in), jq, git, curl and openssl. Works with the bash 3.2 of macOS.
#
#   peppec init     run inside a clone of the host repository; safe to run again
#   peppec doctor   check an installation (-R owner/repo, or the current clone)
#   peppec bot      prepare the folder to copy to the machine that runs the Telegram bot
#   peppec update   replace this script with the current one of the engine
set -euo pipefail

ENGINE="${PEPPEC_ENGINE:-PeppeColi/peppec}"
REF="${PEPPEC_REF:-v1}"
YES=false
REPO=""
REPO_LIST=""
KEY_FILE=""
PRESET=""
BASE_BRANCH=main
OUT_DIR="peppec-bot"
SECRETS="CLAUDE_CODE_OAUTH_TOKEN AGENT_TOKEN APP_PRIVATE_KEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID"
WORK_DIRS=".agent/ _ctl/ _preset/ _extra/ _base/"

LABELS='ready|Ready to be picked up by the agents
size: S|Small issue, for the lightest model (Haiku by default)
size: M|Medium issue, the default (Sonnet by default)
size: L|Large issue, for the strongest model (Opus by default)
in progress|An agent is working on this issue
question open|The agent is waiting for an answer
awaiting quota|Paused until the Claude quota resets
needs human|Limits exceeded, manual action required
ready to merge|Review passed, waiting for manual merge
review 1|Review round 1
review 2|Review round 2
review 3|Review round 3
ci 1|Check fix attempt 1
ci 2|Check fix attempt 2
ci 3|Check fix attempt 3
ci 4|Check fix attempt 4
ci 5|Check fix attempt 5
paused|Queue paused (control panel)
auto mode|Automatic merge enabled (control panel)
always on|New issues start at any hour, not only at night (control panel)
base missing|The base branch does not exist: queue stopped until it is back (control panel)'

# name|default|question; an empty default means the value is computed or asked without one
NUMBERS='WORK_START_HOUR|22|Hour at which agents may start new issues (0-23)
WORK_END_HOUR|9|Hour at which agents stop starting new issues (0-23)
MAX_REVIEW_ROUNDS|3|Review rounds before the queue stops
LARGE_FROM_ROUND|3|Review round from which the model of size L takes over
MAX_CI_ATTEMPTS|5|Attempts to fix the checks, per review round
MAX_ISSUE_MINUTES|120|Agent working time per issue, in minutes
STALL_MINUTES|120|Minutes a pull request may wait for a CI result
QUOTA_RETRY_MINUTES|60|Minutes between retries when the Claude quota is exhausted
SUMMARY_HOUR|9|Hour of the daily summary (0-23)'
VARIABLES="CONTROL_ISSUE OWNER_LOGIN APP_ID APP_LOGIN AGENT_GIT_NAME AGENT_GIT_EMAIL TZ_NAME WORK_START_HOUR WORK_END_HOUR MAX_REVIEW_ROUNDS LARGE_FROM_ROUND MAX_CI_ATTEMPTS MAX_ISSUE_MINUTES STALL_MINUTES QUOTA_RETRY_MINUTES SUMMARY_HOUR CLAUDE_TOKEN_EXPIRES"

# ---------- output ----------
if [ -t 1 ]; then B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'; else B=""; G=""; Y=""; R=""; N=""; fi
PROBLEMS=0
WARNINGS=0
PROBLEM_LIST=""
step() { printf '\n%s%s%s\n' "$B" "$1" "$N"; }
ok() { printf '  %s✓%s %s\n' "$G" "$N" "$1"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$1"; WARNINGS=$((WARNINGS + 1)); }
bad() {
  printf '  %s✗%s %s\n' "$R" "$N" "$1"
  PROBLEMS=$((PROBLEMS + 1))
  PROBLEM_LIST="$PROBLEM_LIST  - $1"$'\n'
}
note() { printf '    %s\n' "$1"; }
die() { printf '%serror:%s %s\n' "$R" "$N" "$1" >&2; exit 1; }

# ---------- input ----------
# ask VAR "question" "default": in --yes mode the default is taken without asking
ask() {
  local answer=""
  if [ "$YES" = false ]; then
    if [ -n "$3" ]; then read -r -p "  $2 [$3]: " answer; else read -r -p "  $2: " answer; fi
  fi
  printf -v "$1" '%s' "${answer:-$3}"
}
ask_hidden() {
  local answer=""
  if [ "$YES" = false ]; then read -r -s -p "  $2: " answer; echo; fi
  printf -v "$1" '%s' "$answer"
}
confirm() { # confirm "question" default(y|n)
  local answer=""
  [ "$YES" = true ] && { [ "$2" = y ]; return; }
  if [ "$2" = y ]; then read -r -p "  $1 [Y/n]: " answer; else read -r -p "  $1 [y/N]: " answer; fi
  answer="${answer:-$2}"
  case "$answer" in y|Y|yes|Yes) return 0;; *) return 1;; esac
}

# ---------- helpers ----------
need() { command -v "$1" > /dev/null 2>&1 || die "$1 is required but not installed"; }
preflight() {
  need gh; need jq; need git; need curl; need openssl
  gh auth status > /dev/null 2>&1 || die "gh is not signed in: run 'gh auth login'"
}
resolve_repo() {
  if [ -z "$REPO" ]; then
    REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2> /dev/null) \
      || die "not inside a clone of a GitHub repository: pass -R owner/repo"
  fi
  gh api "repos/$REPO" --jq .full_name > /dev/null 2>&1 || die "cannot access $REPO"
}
# gh prints the body of an error response on stdout: this keeps only the output of calls
# that succeed, and fails otherwise
api() {
  local out
  if out=$(gh api "$@" 2> /dev/null); then printf '%s\n' "$out"; else return 1; fi
}
engine_file() { api -H "Accept: application/vnd.github.raw" "repos/$ENGINE/contents/$1?ref=$REF"; }
# host_file PATH [BRANCH]: a file of the host repository, on the default branch unless told
host_file() { api -H "Accept: application/vnd.github.raw" "repos/$REPO/contents/$1${2:+?ref=$2}"; }
open_url() {
  if command -v open > /dev/null 2>&1; then open "$1"; elif command -v xdg-open > /dev/null 2>&1; then xdg-open "$1"; else return 1; fi
}
var_of() { jq -r --arg n "$1" '.[] | select(.name == $n) | .value' <<< "$VARS_JSON"; }
load_vars() { VARS_JSON=$(gh variable list -R "$REPO" --json name,value); }
set_var() { # set_var NAME VALUE: writes only when the value changes
  if [ "$(var_of "$1")" = "$2" ]; then ok "$1 = $2"; else
    gh variable set "$1" -R "$REPO" -b "$2" > /dev/null; ok "$1 = $2 (set)"
  fi
}
is_number() { case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
epoch_of() { date -d "$1" +%s 2> /dev/null || date -j -f "%Y-%m-%d" "$1" +%s 2> /dev/null; }
next_year() { date -d "+1 year" +%Y-%m-%d 2> /dev/null || date -v+1y +%Y-%m-%d; }
system_tz() {
  local link; link=$(readlink /etc/localtime 2> /dev/null || true)
  if [ -n "$link" ]; then echo "${link##*zoneinfo/}"; elif [ -f /etc/timezone ]; then cat /etc/timezone; else echo UTC; fi
}
# Minutes east of UTC of a time zone on a given day
tz_offset() {
  local z
  z=$(TZ="$1" date -d "$2 12:00" +%z 2> /dev/null || TZ="$1" date -j -f "%Y-%m-%d %H" "$2 12" +%z)
  local sign=1; [ "${z:0:1}" = "-" ] && sign=-1
  echo $(( sign * (10#${z:1:2} * 60 + 10#${z:3:2}) ))
}
# UTC hours at which the local hour equals $2, in winter and in summer
summary_cron() {
  local hours="" off h
  for day in 2026-01-15 2026-07-15; do
    off=$(tz_offset "$1" "$day")
    h=$(( ( ($2 * 60 - off + 59 + 1440) / 60 ) % 24 ))
    hours="$hours $h"
  done
  # shellcheck disable=SC2086
  echo "0 $(printf '%s\n' $hours | sort -n | uniq | paste -sd, -) * * *"
}

# ---------- GitHub App ----------
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
app_jwt() { # app_jwt APP_ID KEY_FILE
  local now head payload sig
  now=$(date +%s)
  head=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 300)) "$1" | b64url)
  sig=$(printf '%s.%s' "$head" "$payload" | openssl dgst -sha256 -sign "$2" -binary | b64url)
  printf '%s.%s.%s' "$head" "$payload" "$sig"
}
app_api() { # app_api APP_ID KEY_FILE path
  curl -fsS -H "Authorization: Bearer $(app_jwt "$1" "$2")" -H "Accept: application/vnd.github+json" \
    "https://api.github.com$3" 2> /dev/null
}
# Checks the key against the app and the app's installation on the repository; sets APP_SLUG
check_app() { # check_app APP_ID KEY_FILE
  APP_SLUG=$(app_api "$1" "$2" /app | jq -r '.slug // empty' || true)
  if [ -z "$APP_SLUG" ]; then bad "the key does not belong to app $1, or the app does not exist"; return 1; fi
  ok "key valid for the app '$APP_SLUG'"
  if app_api "$1" "$2" "/repos/$REPO/installation" > /dev/null; then
    ok "app installed on $REPO"
  else
    bad "app not installed on $REPO"
    note "Install it: https://github.com/apps/$APP_SLUG/installations/new"
  fi
}

# ---------- Telegram ----------
# The token goes to curl through a config on stdin, so it never shows in the process list
telegram() { curl -fsS -K - <<< "url = \"https://api.telegram.org/bot$1/$2\"" 2> /dev/null; }

# ---------- init ----------
write_file() { # write_file PATH CONTENT
  if [ -f "$1" ]; then
    if [ "$(cat "$1")" = "$2" ]; then ok "$1 (unchanged)"; return; fi
    if ! confirm "$1 exists and differs: overwrite?" n; then warn "$1 kept as it is"; return; fi
  fi
  mkdir -p "$(dirname "$1")"
  printf '%s\n' "$2" > "$1"
  ok "$1 (written)"
}
put_secret() { printf '%s' "$2" | gh secret set "$1" -R "$REPO" > /dev/null; ok "$1 (set)"; }

init_labels() {
  step "Labels"
  local n=0
  while IFS='|' read -r name desc; do
    gh label create "$name" -R "$REPO" --description "$desc" --force > /dev/null
    n=$((n + 1))
  done <<< "$LABELS"
  ok "$n labels present"
}

init_settings() {
  step "Repository settings"
  # Off: GitHub would also delete the base branch each time it is brought to main, and only a ruleset
  # (not available on private repositories of a free plan) could stop it. The workflow removes its own branches
  gh api -X PATCH "repos/$REPO" -F delete_branch_on_merge=false > /dev/null \
    && ok "GitHub does not delete merged branches: the workflow removes the agent's own"
  if [ "$(gh api "repos/$REPO" --jq .private)" = false ]; then
    if gh api -X PUT "repos/$REPO/actions/permissions/fork-pr-contributor-approval" \
         -f approval_policy=all_external_contributors > /dev/null 2>&1; then
      ok "workflows from forks need approval for all external contributors"
    else
      warn "could not set the approval of workflows from forks"
      note "Settings → Actions → General → Require approval for all external contributors"
    fi
  fi
}

init_control_panel() {
  step "Control panel"
  CONTROL=$(gh issue list -R "$REPO" --state open --search 'in:title "Control panel"' --json number,title \
    --jq '[.[] | select(.title == "Control panel")] | sort_by(.number) | .[0].number // empty')
  if [ -n "$CONTROL" ]; then ok "issue #$CONTROL"; return; fi
  local url
  url=$(gh issue create -R "$REPO" --title "Control panel" \
    --body "Labels: paused = queue stopped; auto mode = automatic merge; always on = work at any hour. Do not close.")
  CONTROL="${url##*/}"
  gh issue pin "$CONTROL" -R "$REPO" > /dev/null 2>&1 || true
  ok "issue #$CONTROL (created and pinned)"
}

# Waits for GitHub's redirect on 127.0.0.1 and prints "code state"
APP_LISTENER='
import http.server, sys, time, urllib.parse
got = []
class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if "code" in q:
            got.append(q["code"][0] + " " + q.get("state", [""])[0])
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(b"<p>PEPPEC: done. Close this tab and go back to the terminal.</p>")
    def log_message(self, *args):
        pass
server = http.server.HTTPServer(("127.0.0.1", int(sys.argv[1])), Handler)
server.timeout = 5
deadline = time.time() + 900
while not got and time.time() < deadline:
    server.handle_request()
print(got[0] if got else "")
'

# Registers the app from a manifest: the browser shows GitHub's confirmation page, GitHub
# sends back a code, and the code is exchanged for the App ID and the private key.
# Sets APP_ID, APP_SLUG and KEY_FILE; returns 1 if the app was not created.
create_app() {
  local owner action state port manifest tmp reply="" code="" app listener=""
  owner="${REPO%%/*}"
  if [ "$(gh api "repos/$REPO" --jq .owner.type)" = Organization ]; then
    action="https://github.com/organizations/$owner/settings/apps/new"
  else
    action="https://github.com/settings/apps/new"
  fi
  state=$(openssl rand -hex 16)
  port=$((20000 + RANDOM % 20000))
  # The same settings as docs/setup.md, Phase 2: no webhook, only this account can install it
  manifest=$(jq -cn --arg name "peppec-$owner" --arg url "https://github.com/$REPO" --arg redirect "http://127.0.0.1:$port/" \
    '{name: $name[0:34], url: $url, redirect_url: $redirect, public: false,
      description: "Applies labels, merges pull requests and runs the Telegram bot commands of PEPPEC.",
      hook_attributes: {url: $url, active: false},
      default_permissions: {actions: "write", contents: "write", issues: "write", pull_requests: "write", checks: "read"}}')
  tmp=$(mktemp -d) || die "cannot create a temporary folder"
  jq -rn --arg action "$action?state=$state" --arg manifest "$manifest" \
    '"<!doctype html><meta charset=\"utf-8\"><title>PEPPEC</title><body onload=\"document.forms[0].submit()\">"
     + "<form method=\"post\" action=\"\($action | @html)\"><input type=\"hidden\" name=\"manifest\" value=\"\($manifest | @html)\">"
     + "<button>Continue to GitHub</button></form>"' > "$tmp/app.html"
  if command -v python3 > /dev/null 2>&1; then
    python3 -c "$APP_LISTENER" "$port" > "$tmp/reply" 2> /dev/null &
    listener=$!
  fi
  note "GitHub shows the app's name, which you can change, and a button to create it."
  note "Permissions: Actions, Contents, Issues, Pull requests read and write; Checks read-only."
  if ! open_url "file://$tmp/app.html"; then note "Open this file in your browser: $tmp/app.html"; fi
  if [ -n "$listener" ]; then
    note "Waiting for you to create the app in the browser (Ctrl-C to give up)..."
    wait "$listener" || true
    reply=$(cat "$tmp/reply")
  fi
  if [ -z "$reply" ]; then
    # No python3, or the port was taken: the address of the page GitHub lands on carries the code
    note "After the app is created the browser lands on a page that does not load."
    ask reply "Paste the address of that page" ""
    code=$(sed -n 's/.*[?&]code=\([^&]*\).*/\1/p' <<< "$reply")
    reply="$code $(sed -n 's/.*[?&]state=\([^&]*\).*/\1/p' <<< "$reply")"
  fi
  rm -rf "$tmp"
  code="${reply%% *}"
  if [ -z "$code" ] || [ "${reply#* }" != "$state" ]; then bad "the app was not created: no valid answer from GitHub"; return 1; fi
  if ! app=$(curl -fsS -X POST -H "Accept: application/vnd.github+json" \
    "https://api.github.com/app-manifests/$code/conversions" 2> /dev/null); then
    bad "GitHub did not accept the code of the new app: delete the app on GitHub and try again"; return 1
  fi
  APP_ID=$(jq -r .id <<< "$app"); APP_SLUG=$(jq -r .slug <<< "$app")
  KEY_FILE="$HOME/$APP_SLUG.private-key.pem"
  [ -e "$KEY_FILE" ] && KEY_FILE="$HOME/$APP_SLUG.$APP_ID.private-key.pem"
  ( umask 077; jq -r .pem <<< "$app" > "$KEY_FILE" )
  ok "app '$APP_SLUG' created, App ID $APP_ID"
  ok "private key saved in $KEY_FILE (readable only by you)"
  note "'peppec bot' needs that file: keep it until the bot runs, then delete it."
  note "Now install the app: choose 'Only select repositories' and pick ${REPO##*/}."
  open_url "https://github.com/apps/$APP_SLUG/installations/new" \
    || note "Open https://github.com/apps/$APP_SLUG/installations/new"
  read -r -p "  Press Enter when the app is installed: " reply
}

init_app() {
  step "GitHub App"
  local current; current=$(var_of APP_ID)
  note "The app that applies labels and merges, and that the Telegram bot acts as."
  APP_ID=""; APP_SLUG=""
  KEY_FILE="${KEY_FILE:-${PEPPEC_APP_KEY_FILE:-}}"
  if [ -z "$current" ] && [ -z "${PEPPEC_APP_ID:-}" ] && [ "$YES" = false ]; then
    note "One app can serve several repositories: answer no if you already have it."
    if confirm "Create the app now, in the browser?" y; then create_app || true; fi
  fi
  if [ -z "$APP_ID" ]; then
    note "To create it by hand follow docs/setup.md, Phase 2."
    ask APP_ID "App ID" "${PEPPEC_APP_ID:-$current}"
  fi
  is_number "$APP_ID" || { bad "no App ID: set it later with 'gh variable set APP_ID'"; APP_ID=""; return; }
  local has_key=false
  grep -qx APP_PRIVATE_KEY <<< "$SECRET_NAMES" && has_key=true
  if [ -z "$KEY_FILE" ] && [ "$YES" = false ]; then
    if [ "$has_key" = true ]; then
      ask KEY_FILE "Path of the app's private key (.pem), empty to keep the stored one" ""
    else
      ask KEY_FILE "Path of the app's private key (.pem)" ""
    fi
  fi
  KEY_FILE="${KEY_FILE/#\~/$HOME}"
  if [ -n "$KEY_FILE" ]; then
    [ -f "$KEY_FILE" ] || { bad "no such file: $KEY_FILE"; KEY_FILE=""; }
  fi
  if [ -n "$KEY_FILE" ]; then
    if check_app "$APP_ID" "$KEY_FILE"; then
      gh secret set APP_PRIVATE_KEY -R "$REPO" < "$KEY_FILE" > /dev/null
      ok "APP_PRIVATE_KEY (set)"
    fi
  elif [ "$has_key" = true ]; then
    ok "APP_PRIVATE_KEY (kept)"
  else
    bad "APP_PRIVATE_KEY missing: run init again with --key <file>"
  fi
  if [ -z "$APP_SLUG" ]; then
    current=$(var_of APP_LOGIN)
    ask APP_SLUG "App short name, as in its URL" "${current%\[bot\]}"
  fi
}

init_variables() {
  step "Variables"
  local me name email value
  me=$(gh api user)
  set_var CONTROL_ISSUE "$CONTROL"
  set_var OWNER_LOGIN "$(jq -r .login <<< "$me")"
  [ -n "$APP_ID" ] && set_var APP_ID "$APP_ID"
  if [ -n "$APP_SLUG" ]; then set_var APP_LOGIN "${APP_SLUG}[bot]"; else bad "APP_LOGIN not set: the app's short name is unknown"; fi
  name=$(var_of AGENT_GIT_NAME); email=$(var_of AGENT_GIT_EMAIL)
  ask value "Name on the agent's commits" "${name:-$(jq -r '.name // .login' <<< "$me")}"
  set_var AGENT_GIT_NAME "$value"
  ask value "Email on the agent's commits" "${email:-$(jq -r '"\(.id)+\(.login)@users.noreply.github.com"' <<< "$me")}"
  set_var AGENT_GIT_EMAIL "$value"
  value=$(var_of TZ_NAME)
  ask TZ_NAME "Time zone" "${value:-$(system_tz)}"
  TZ="$TZ_NAME" date > /dev/null 2>&1 || die "unknown time zone: $TZ_NAME"
  set_var TZ_NAME "$TZ_NAME"
  value=$(var_of BASE_BRANCH)
  ask BASE_BRANCH "Branch the agent starts from and its pull requests are merged into" "${value:-main}"
  git check-ref-format --branch "$BASE_BRANCH" > /dev/null 2>&1 || die "not a branch name: $BASE_BRANCH"
  set_var BASE_BRANCH "$BASE_BRANCH"
  # The list is read on descriptor 3, so the questions can still read the terminal
  while IFS='|' read -r name default question <&3; do
    value=$(var_of "$name")
    ask value "$question" "${value:-$default}"
    is_number "$value" || die "$name must be a number"
    set_var "$name" "$value"
    if [ "$name" = SUMMARY_HOUR ]; then SUMMARY_HOUR="$value"; fi
  done 3<<< "$NUMBERS"
}

# The personal token is the one people confuse with the app's key or with gh's own token
explain_agent_token() {
  local name="peppec workflow - ${REPO##*/}" url
  url="https://github.com/settings/personal-access-tokens/new?$(jq -rn --arg n "${name:0:40}" \
    --arg d "Pushes PEPPEC agent commits and opens pull requests. If it expires, the queue stops: regenerate it and update AGENT_TOKEN." \
    '"name=\($n | @uri)&description=\($d | @uri)&expires_in=365&contents=write&issues=write&pull_requests=write&actions=read"')"
  note "${B}AGENT_TOKEN${N}: a personal access token of your GitHub account."
  note "It is not the app's key, and not the token gh uses on this computer."
  note "The workflow uses it to push the agent's commits and open pull requests in your name."
  note "Create a fine-grained token; this link fills in name, description, expiry and permissions:"
  note "  $url"
  note "On that page:"
  note "  Repository access:  Only select repositories → $REPO"
  note "  Permissions:        Contents, Issues, Pull requests → Read and write; Actions → Read-only"
  note "                      (leave Workflows out: the agent must not change them)"
  note "  Expiration:         one year; when it expires the queue stops until you replace it"
  if confirm "Open the link in the browser now?" y; then open_url "$url" || note "Could not open a browser: copy the link."; fi
}

init_secrets() {
  step "Secrets"
  note "Values are read without echo and sent straight to GitHub: nothing is written to disk."
  local name value existing
  for name in CLAUDE_CODE_OAUTH_TOKEN AGENT_TOKEN TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID; do
    existing=false; grep -qx "$name" <<< "$SECRET_NAMES" && existing=true
    value="${!name:-}"
    if [ -z "$value" ] && [ "$YES" = false ]; then
      if [ "$existing" = true ] && ! confirm "$name is already set: replace it?" n; then ok "$name (kept)"; continue; fi
      echo
      case "$name" in
        CLAUDE_CODE_OAUTH_TOKEN)
          note "${B}CLAUDE_CODE_OAUTH_TOKEN${N}: lets the agent use Claude Code with your subscription."
          note "Run 'claude setup-token' in another terminal and paste the token it prints.";;
        AGENT_TOKEN) explain_agent_token;;
        TELEGRAM_BOT_TOKEN)
          note "${B}TELEGRAM_BOT_TOKEN${N}: the token of your Telegram bot, used to send you notifications."
          note "From @BotFather: /newbot for a new bot, or /mybots → your bot → API Token.";;
        TELEGRAM_CHAT_ID)
          note "${B}TELEGRAM_CHAT_ID${N}: the chat the notifications go to, and the only one the bot obeys."
          if [ -n "${BOT_TOKEN:-}" ]; then
            note "Send any message to your bot now, then press Enter (empty to type the ID yourself)."
            read -r -p "  " _ || true
            value=$(telegram "$BOT_TOKEN" getUpdates | jq -r '[.result[] | .message.chat.id // empty] | last // empty' || true)
            if [ -n "$value" ]; then ok "chat ID detected"; else note "No message found (a running bot consumes them): type the ID."; fi
          fi;;
      esac
      if [ -z "$value" ]; then
        if [ "$name" = TELEGRAM_CHAT_ID ]; then ask value "TELEGRAM_CHAT_ID" ""
        else ask_hidden value "Paste $name (it will not be shown)"; fi
      fi
    fi
    if [ -z "$value" ]; then
      if [ "$existing" = true ]; then ok "$name (kept)"; else bad "$name missing"; fi
      continue
    fi
    case "$name" in
      CLAUDE_CODE_OAUTH_TOKEN)
        case "$value" in sk-ant-oat*) ;; *) warn "the value does not look like a token from 'claude setup-token'";; esac
        NEW_CLAUDE_TOKEN=true;;
      AGENT_TOKEN)
        if [ "$(GH_TOKEN="$value" gh api "repos/$REPO" --jq .permissions.push 2> /dev/null)" = true ]; then
          ok "the token can write to $REPO"
        else bad "AGENT_TOKEN cannot write to $REPO: not stored. Check its repository access and permissions"; continue; fi
        NEW_AGENT_TOKEN=true;;
      TELEGRAM_BOT_TOKEN)
        if telegram "$value" getMe | jq -e .ok > /dev/null 2>&1; then ok "Telegram accepts the bot token"; BOT_TOKEN="$value"
        else bad "Telegram rejects the bot token: not stored"; continue; fi;;
      TELEGRAM_CHAT_ID)
        case "$value" in -[0-9]*|[0-9]*) ;; *) bad "the chat ID must be a number: not stored"; continue;; esac;;
    esac
    put_secret "$name" "$value"
  done
  local expires; expires=$(var_of AGENT_TOKEN_EXPIRES)
  if [ "${NEW_AGENT_TOKEN:-false}" = true ] || [ -z "$expires" ]; then
    local proposal="$expires"
    if [ "${NEW_AGENT_TOKEN:-false}" = true ]; then proposal=$(next_year); fi
    ask expires "Expiry date of AGENT_TOKEN, as shown by GitHub (YYYY-MM-DD, empty if it never expires)" "$proposal"
  fi
  if [ -z "$expires" ]; then warn "AGENT_TOKEN_EXPIRES not set: no warning before the personal token expires"
  elif epoch_of "$expires" > /dev/null; then set_var AGENT_TOKEN_EXPIRES "$expires"
  else bad "AGENT_TOKEN_EXPIRES: '$expires' is not a date (YYYY-MM-DD)"; fi
  expires=$(var_of CLAUDE_TOKEN_EXPIRES)
  if [ "${NEW_CLAUDE_TOKEN:-false}" = true ]; then
    set_var CLAUDE_TOKEN_EXPIRES "$(next_year)"
  elif [ -n "$expires" ]; then
    ok "CLAUDE_TOKEN_EXPIRES = $expires"
  else
    ask expires "Expiry date of the Claude token (YYYY-MM-DD, one year after it was generated)" "$(next_year)"
    set_var CLAUDE_TOKEN_EXPIRES "$expires"
  fi
}

init_files() {
  step "Files"
  local presets detected="" content f line cron
  presets=$(gh api "repos/$ENGINE/contents/presets?ref=$REF" --jq '.[].name')
  if [ -z "$PRESET" ] && [ -f .github/peppec.yml ]; then
    PRESET=$(sed -n 's/^preset:[[:space:]]*//p' .github/peppec.yml | head -n 1)
  fi
  if [ -z "$PRESET" ]; then
    [ -f Cargo.toml ] && detected=rust-v1
    [ -f composer.json ] && detected=php-v1
    note "Available presets: $(echo $presets)"
    ask PRESET "Preset" "$detected"
  fi
  grep -qx "$PRESET" <<< "$presets" || die "unknown preset '$PRESET'"
  ok "preset $PRESET"

  cron=$(summary_cron "$TZ_NAME" "$SUMMARY_HOUR")
  for f in agent ci summary; do
    content=$(engine_file "examples/$f.yml" | sed -e '/^# Copy to /d' \
      -e "s|\\.yml@v1\$|.yml@$REF|" -e "s|engine_ref: v1|engine_ref: $REF|" \
      -e "s|cron: '0 7,8 \\* \\* \\*'|cron: '$cron'|")
    write_file ".github/workflows/$f.yml" "$content"
  done
  if [ -f .github/peppec.yml ]; then ok ".github/peppec.yml (kept)"; else
    write_file .github/peppec.yml "$(engine_file examples/peppec.yml | sed -e '/^# Copy to /d' -e "s|^preset: .*|preset: $PRESET|")"
  fi
  write_file .coderabbit.yaml "$(engine_file examples/coderabbit.yaml | sed -e '/^# Copy to /d')"
  touch .gitignore
  local added=""
  for line in $WORK_DIRS; do
    grep -qxF "$line" .gitignore || { printf '%s\n' "$line" >> .gitignore; added="$added $line"; }
  done
  if [ -n "$added" ]; then ok ".gitignore (added:$added)"; else ok ".gitignore (unchanged)"; fi
}

# True when a deletion rule applies to the base branch from a ruleset without a bypass list
base_branch_kept() {
  local id
  for id in $(gh api "repos/$REPO/rules/branches/$BASE_BRANCH" \
      --jq '.[] | select(.type == "deletion") | .ruleset_id' 2> /dev/null); do
    [ "$(gh api "repos/$REPO/rulesets/$id" --jq '.bypass_actors | length' 2> /dev/null)" != 0 ] || return 0
  done
  return 1
}

# A second guard for the base branch, where rulesets exist: it is the head of the pull request that brings it
# to main, and the "Delete branch" button of that pull request would remove it.
# The main ruleset does not stop it: admins bypass it, and the one who merges is usually an admin.
init_keep_base() {
  [ "$BASE_BRANCH" != main ] || return 0
  if base_branch_kept; then ok "$BASE_BRANCH is kept after its merges into main"; return; fi
  if jq -n --arg name "keep $BASE_BRANCH" --arg base "$BASE_BRANCH" '{name: $name, target: "branch", enforcement: "active",
        conditions: {ref_name: {include: ["refs/heads/" + $base], exclude: []}},
        bypass_actors: [], rules: [{type: "deletion"}]}' \
      | gh api -X POST "repos/$REPO/rulesets" --input - > /dev/null 2>&1; then
    ok "ruleset 'keep $BASE_BRANCH' created: nobody can delete $BASE_BRANCH"
  else
    warn "$BASE_BRANCH can be deleted by hand (no rulesets here): do not press \"Delete branch\" after merging it into main"
  fi
}

init_ruleset() {
  step "Branch protection"
  local existing branches=main
  [ "$BASE_BRANCH" = main ] || branches="main and $BASE_BRANCH"
  if ! existing=$(api "repos/$REPO/rulesets" --jq '.[] | select(.target == "branch") | .id'); then
    warn "$branches not protected: rulesets are not available here (private repositories need a paid plan)"
    return
  fi
  if [ -n "$existing" ]; then
    ok "a branch ruleset already exists: left as it is"
    note "It should require the status check 'ci / ci' on $branches."
    return
  fi
  if jq -n --arg name "$branches" --arg base "$BASE_BRANCH" '{name: $name, target: "branch", enforcement: "active",
        conditions: {ref_name: {include: (["refs/heads/main", "refs/heads/" + $base] | unique), exclude: []}},
        bypass_actors: [{actor_id: 5, actor_type: "RepositoryRole", bypass_mode: "always"}],
        rules: [{type: "deletion"}, {type: "non_fast_forward"},
          {type: "pull_request", parameters: {required_approving_review_count: 0,
            dismiss_stale_reviews_on_push: false, require_code_owner_review: false,
            require_last_push_approval: false, required_review_thread_resolution: false}},
          {type: "required_status_checks", parameters: {strict_required_status_checks_policy: false,
            required_status_checks: [{context: "ci / ci"}]}}]}' \
      | gh api -X POST "repos/$REPO/rulesets" --input - > /dev/null 2>&1; then
    ok "ruleset '$branches' created: pull request and the check 'ci / ci' required, admins can bypass"
  else
    warn "could not create the ruleset (rulesets on private repositories need a paid plan)"
  fi
}

cmd_init() {
  preflight
  git rev-parse --show-toplevel > /dev/null 2>&1 || die "run init inside a clone of the host repository"
  cd "$(git rev-parse --show-toplevel)"
  [ -n "$REPO" ] && die "init works on the current clone: do not pass -R"
  resolve_repo
  [ "$(gh api "repos/$REPO" --jq .default_branch)" = main ] || die "the default branch of $REPO must be 'main'"
  printf '%sPEPPEC%s on %s%s%s, engine %s@%s\n' "$B" "$N" "$B" "$REPO" "$N" "$ENGINE" "$REF"
  load_vars
  SECRET_NAMES=$(gh secret list -R "$REPO" --json name --jq '.[].name')
  init_labels
  init_settings
  init_control_panel
  init_app
  init_variables
  init_secrets
  init_files
  init_ruleset
  init_keep_base

  step "Next steps"
  note "1. Review the files, then commit and push them to main:"
  note "     git add .github .coderabbit.yaml .gitignore && git commit -m 'chore: install PEPPEC' && git push"
  local n=2
  if [ "$BASE_BRANCH" != main ]; then
    note "2. Bring $BASE_BRANCH level with main, so it has the same files (this also creates it):"
    note "     git push origin main:$BASE_BRANCH"
    n=3
  fi
  note "$n. Install CodeRabbit on $REPO: https://github.com/apps/coderabbitai"
  note "$((n + 1)). Prepare the Telegram bot: peppec bot"
  note "$((n + 2)). Check everything: peppec doctor"
  if [ "$PROBLEMS" -gt 0 ]; then
    printf '\n%s%d problem(s) to fix, then run init again (it keeps what is already set):%s\n%s' "$R" "$PROBLEMS" "$N" "$PROBLEM_LIST"
    exit 1
  fi
}

# ---------- doctor ----------
# A file that is not on the default branch: say so, and whether it is waiting in the local clone
missing_file() {
  if [ "$IN_CLONE" = true ] && [ -f "$CLONE_ROOT/$1" ]; then
    bad "$1 is in your clone but not on ${2:-main} yet: commit and push it"
  else
    bad "$1 missing on ${2:-the default branch}"
  fi
}

cmd_doctor() {
  preflight
  IN_CLONE=false; CLONE_ROOT=""
  if [ -z "$REPO" ] && CLONE_ROOT=$(git rev-parse --show-toplevel 2> /dev/null); then IN_CLONE=true; fi
  resolve_repo
  printf '%sPEPPEC doctor%s for %s%s%s\n' "$B" "$N" "$B" "$REPO" "$N"
  load_vars

  step "Labels"
  local have missing="" name
  have=$(gh label list -R "$REPO" --limit 200 --json name --jq '.[].name')
  while IFS='|' read -r name _; do grep -qxF "$name" <<< "$have" || missing="$missing '$name'"; done <<< "$LABELS"
  if [ -z "$missing" ]; then ok "all labels present"; else bad "missing labels:$missing"; fi

  step "Variables"
  missing=""
  for name in $VARIABLES; do [ -n "$(var_of "$name")" ] || missing="$missing $name"; done
  if [ -z "$missing" ]; then ok "all variables set"; else bad "missing variables:$missing"; fi
  while IFS='|' read -r name _ _; do
    local v; v=$(var_of "$name"); [ -z "$v" ] || is_number "$v" || bad "$name is not a number: $v"
  done <<< "$NUMBERS"
  # Not in the list above: without it the base branch is main
  BASE_BRANCH=$(var_of BASE_BRANCH); BASE_BRANCH="${BASE_BRANCH:-main}"
  local default_branch; default_branch=$(gh api "repos/$REPO" --jq .default_branch)
  if [ "$BASE_BRANCH" = "$default_branch" ]; then ok "base branch: $BASE_BRANCH"
  elif gh api "repos/$REPO/branches/$BASE_BRANCH" > /dev/null 2>&1; then
    ok "base branch: $BASE_BRANCH (issues are closed by the workflow; you merge it into $default_branch)"
  else
    bad "the base branch '$BASE_BRANCH' does not exist: git push origin $default_branch:$BASE_BRANCH"
    # One problem, one line: the checks below look at $default_branch, the branch it will be created from
    BASE_BRANCH="$default_branch"
  fi
  local tz; tz=$(var_of TZ_NAME)
  if [ -n "$tz" ] && [ ! -e "/usr/share/zoneinfo/$tz" ] && [ ! -e "/var/db/timezone/zoneinfo/$tz" ]; then
    warn "TZ_NAME '$tz' is not a time zone known to this computer"
  fi
  local expires days label
  for name in CLAUDE_TOKEN_EXPIRES AGENT_TOKEN_EXPIRES; do
    label="Claude token"; [ "$name" = AGENT_TOKEN_EXPIRES ] && label="personal token (AGENT_TOKEN)"
    expires=$(var_of "$name")
    if [ -z "$expires" ]; then
      [ "$name" = AGENT_TOKEN_EXPIRES ] && warn "AGENT_TOKEN_EXPIRES not set: no warning before the personal token expires"
      continue
    fi
    if days=$(epoch_of "$expires"); then
      days=$(( (days - $(date +%s)) / 86400 ))
      if [ "$days" -lt 0 ]; then bad "the $label expired on $expires"
      elif [ "$days" -le 30 ]; then warn "the $label expires in $days days ($expires)"
      else ok "$label valid for $days more days"; fi
    else bad "$name is not a date: $expires"; fi
  done

  step "Secrets"
  have=$(gh secret list -R "$REPO" --json name --jq '.[].name')
  missing=""
  for name in $SECRETS; do grep -qx "$name" <<< "$have" || missing="$missing $name"; done
  if [ -z "$missing" ]; then ok "all secrets set (their values cannot be read back)"; else bad "missing secrets:$missing"; fi

  step "GitHub App"
  local app_id; app_id=$(var_of APP_ID)
  KEY_FILE="${KEY_FILE/#\~/$HOME}"
  if [ -n "$KEY_FILE" ] && [ -n "$app_id" ]; then
    [ -f "$KEY_FILE" ] || die "no such file: $KEY_FILE"
    if check_app "$app_id" "$KEY_FILE"; then
      [ "${APP_SLUG}[bot]" = "$(var_of APP_LOGIN)" ] || bad "APP_LOGIN is '$(var_of APP_LOGIN)' but the app is '${APP_SLUG}[bot]'"
    fi
  else
    warn "installation not checked: pass --key <the app's .pem file> to check it"
  fi

  step "Control panel"
  local control state; control=$(var_of CONTROL_ISSUE)
  if [ -n "$control" ]; then
    state=$(gh issue view "$control" -R "$REPO" --json state,title,labels \
      --jq '"\(.state)|\(.title)|\([.labels[].name] | join(", "))"' 2> /dev/null || true)
    if [ -z "$state" ]; then bad "issue #$control does not exist"
    elif [ "${state%%|*}" != OPEN ]; then bad "issue #$control is closed: reopen it"
    else
      ok "issue #$control open"
      case "$state" in *"auto mode"*) note "merge mode: automatic";; *) note "merge mode: manual";; esac
      case "$state" in *"always on"*) note "schedule: always";; *) note "schedule: nightly";; esac
      case "$state" in *paused*) warn "the queue is paused";; esac
      case "$state" in *"base missing"*) warn "the queue is stopped: its base branch was missing at the last run";; esac
    fi
  fi

  step "Workflows and configuration"
  local states f content ref eref preset
  states=$(gh workflow list -R "$REPO" --all --json path,state --jq '.[] | "\(.path)|\(.state)"')
  for f in agent ci summary; do
    content=$(host_file ".github/workflows/$f.yml" || true)
    if [ -z "$content" ]; then missing_file ".github/workflows/$f.yml"; continue; fi
    ref=$(sed -n "s|.*uses: .*/\\.github/workflows/$f\\.yml@\\(.*\\)\$|\\1|p" <<< "$content" | head -n 1)
    eref=$(sed -n 's/^[[:space:]]*engine_ref:[[:space:]]*//p' <<< "$content" | head -n 1)
    if [ -z "$ref" ]; then bad "$f.yml does not call the engine's workflow"
    elif [ "$ref" != "$eref" ]; then bad "$f.yml: the ref after '@' is '$ref' but engine_ref is '$eref'"
    else ok "$f.yml calls the engine at $ref"; fi
    state=$(sed -n "s#^\\.github/workflows/$f\\.yml|##p" <<< "$states")
    case "$state" in
      active|"") ;;
      *) bad "the '$f' workflow is disabled ($state): gh workflow enable $f.yml -R $REPO";;
    esac
  done
  # GitHub takes the workflow files from the default branch for scheduled and manual runs,
  # and from the base branch for the runs a pull request starts: they must not differ
  if [ "$BASE_BRANCH" != "$default_branch" ]; then
    for f in agent ci summary; do
      [ "$(host_file ".github/workflows/$f.yml" || true)" = "$(host_file ".github/workflows/$f.yml" "$BASE_BRANCH" || true)" ] \
        || bad "$f.yml differs between $BASE_BRANCH and $default_branch: merge $default_branch into $BASE_BRANCH"
    done
  fi
  # The agent and the checks of its pull requests read the configuration from the base branch
  content=$(host_file .github/peppec.yml "$BASE_BRANCH" || true)
  if [ "$BASE_BRANCH" != "$default_branch" ] && [ -n "$content" ] \
     && [ "$content" != "$(host_file .github/peppec.yml || true)" ]; then
    warn ".github/peppec.yml differs between $BASE_BRANCH and $default_branch: the agent uses the one on $BASE_BRANCH"
  fi
  preset=$(sed -n 's/^preset:[[:space:]]*//p' <<< "$content" | head -n 1)
  if [ -z "$content" ]; then missing_file .github/peppec.yml "$BASE_BRANCH"
  elif [ -z "$preset" ]; then bad ".github/peppec.yml has no preset"
  elif gh api "repos/$ENGINE/contents/presets/$preset/preset.yml?ref=${ref:-$REF}" > /dev/null 2>&1; then ok "preset $preset"
  else bad "preset '$preset' does not exist in the engine at ${ref:-$REF}"; fi
  content=$(host_file .coderabbit.yaml || true)
  if [ -z "$content" ]; then missing_file .coderabbit.yaml
  elif ! grep -A1 'auto_approvals:' <<< "$content" | grep -q 'enabled: true'; then
    bad ".coderabbit.yaml: auto_approvals must be enabled, the approval is the 'review passed' signal"
  else ok ".coderabbit.yaml approves automatically"; fi
  if api "repos/$REPO/issues/comments?per_page=100&sort=created&direction=desc" \
       --jq '.[].user.login' | grep -qx 'coderabbitai\[bot\]'; then
    ok "CodeRabbit is active: it commented recently"
  else
    warn "no recent comment from CodeRabbit: check that it is installed on $REPO"
  fi

  step "Branch protection"
  local checks branch branches="$default_branch"
  [ "$BASE_BRANCH" = "$default_branch" ] || branches="$default_branch $BASE_BRANCH"
  for branch in $branches; do
    if ! checks=$(api "repos/$REPO/rules/branches/$branch" \
        --jq '[.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context] | join(", ")'); then
      warn "$branch is not protected: rulesets are not available here (private repositories need a paid plan)"
    elif [ -z "$checks" ]; then warn "$branch requires no status check: add 'ci / ci' to an active ruleset"
    elif grep -q 'ci / ci' <<< "$checks"; then ok "$branch requires: $checks"
    else bad "$branch requires '$checks', but the engine's CI check is named 'ci / ci'"; fi
  done
  # Bringing the base branch to $default_branch makes it the head of a merged pull request, which GitHub deletes
  # when "Automatically delete head branches" is on. A deletion rule stops that only in a ruleset nobody can
  # bypass: the one who merges is usually an admin.
  if [ "$(gh api "repos/$REPO" --jq .delete_branch_on_merge 2> /dev/null)" != true ]; then
    ok "GitHub does not delete merged branches: the workflow removes the agent's own"
  elif [ "$BASE_BRANCH" != "$default_branch" ] && ! base_branch_kept; then
    bad "$BASE_BRANCH will be deleted when you merge it into $default_branch: run peppec init, which turns off \"Automatically delete head branches\""
  else
    warn "GitHub deletes merged branches (\"Automatically delete head branches\" is on): run peppec init to turn it off"
  fi

  step "Last runs"
  for f in ci agent; do
    state=$(gh run list -R "$REPO" --workflow "$f.yml" --limit 1 --json conclusion,status,createdAt \
      --jq '.[0] | "\(if (.conclusion // "") == "" then .status else .conclusion end) on \(.createdAt[0:10])"' 2> /dev/null || true)
    # A run that has not finished has an empty conclusion: its status is shown, without a warning
    case "$state" in
      success*) ok "$f: $state";;
      ""|null*) note "$f: never run";;
      queued*|in_progress*|waiting*|pending*|requested*) note "$f: $state";;
      *) warn "$f: $state";;
    esac
  done

  echo
  if [ "$PROBLEMS" -gt 0 ]; then printf '%s%d problem(s)%s, %d warning(s)\n' "$R" "$PROBLEMS" "$N" "$WARNINGS"; exit 1; fi
  printf '%sNo problems%s, %d warning(s)\n' "$G" "$N" "$WARNINGS"
}

# ---------- bot ----------
cmd_bot() {
  preflight
  local app_id="" id control token chat repos="" r
  if [ -z "$REPO_LIST" ]; then resolve_repo; REPO_LIST="$REPO"; fi
  # One bot follows several repositories, as long as they share the app
  for r in $REPO_LIST; do
    REPO="$r"
    resolve_repo
    load_vars
    id=$(var_of APP_ID); control=$(var_of CONTROL_ISSUE)
    [ -n "$id" ] && [ -n "$control" ] || die "APP_ID or CONTROL_ISSUE not set on $REPO: run 'peppec init' first"
    [ -z "$app_id" ] || [ "$id" = "$app_id" ] \
      || die "$REPO uses another GitHub App ($id instead of $app_id): a bot follows repositories that share the app"
    app_id="$id"
    repos="${repos:+$repos,}$REPO#$control"
  done
  [ -e "$OUT_DIR" ] && die "$OUT_DIR already exists: remove it or pass --out <dir>"
  printf '%sPEPPEC bot%s for %s%s%s → %s/\n' "$B" "$N" "$B" "${repos//,/, }" "$N" "$OUT_DIR"
  step "Values"
  note "The same bot token and chat ID stored as secrets: GitHub cannot give them back."
  note "Every repository listed must use this same bot and chat."
  token="${TELEGRAM_BOT_TOKEN:-}"; [ -n "$token" ] || ask_hidden token "TELEGRAM_BOT_TOKEN"
  chat="${TELEGRAM_CHAT_ID:-}"; [ -n "$chat" ] || ask chat "TELEGRAM_CHAT_ID" ""
  [ -n "$token" ] && [ -n "$chat" ] || die "bot token and chat ID are required"
  telegram "$token" getMe | jq -e .ok > /dev/null 2>&1 || die "Telegram rejects the bot token"
  KEY_FILE="${KEY_FILE:-${PEPPEC_APP_KEY_FILE:-}}"
  [ -n "$KEY_FILE" ] || ask KEY_FILE "Path of the app's private key (.pem)" ""
  KEY_FILE="${KEY_FILE/#\~/$HOME}"
  [ -f "$KEY_FILE" ] || die "no such file: $KEY_FILE"
  for r in $REPO_LIST; do
    REPO="$r"
    check_app "$app_id" "$KEY_FILE" || die "the key is not valid for app $app_id"
  done

  step "Folder"
  ( umask 077
    mkdir -p "$OUT_DIR/data"
    cp "$KEY_FILE" "$OUT_DIR/data/app.pem"
    printf 'TELEGRAM_BOT_TOKEN=%s\nTELEGRAM_CHAT_ID=%s\nAPP_ID=%s\nREPOS=%s\n' \
      "$token" "$chat" "$app_id" "$repos" > "$OUT_DIR/.env" )
  engine_file bot/docker-compose.yml | sed '/^# Copy to /d' > "$OUT_DIR/docker-compose.yml"
  ok "$OUT_DIR/ ready: docker-compose.yml, .env, data/app.pem (readable only by you)"

  step "Next steps"
  note "1. Copy it to the bot's machine:   scp -r $OUT_DIR <user>@<address>:~/"
  note "2. Start the bot there:            cd ~/$OUT_DIR && docker compose up -d"
  note "3. Send /status to the bot on Telegram."
  note "${B}4. Delete the folder from this computer: it holds the key and the token.${N}"
  note "     rm -rf $OUT_DIR"
  note "To follow one more repository later, add it to REPOS in the .env on the bot's machine"
  note "(owner/name#N, N being its control panel issue) and run 'docker compose up -d' again."
}

# ---------- update ----------
cmd_update() {
  preflight
  local self="${BASH_SOURCE[0]}" tmp
  case "$self" in /dev/*|/proc/*) die "this copy is not a file on disk: nothing to update";; esac
  [ -f "$self" ] && [ -w "$self" ] || die "cannot write $self"
  tmp=$(mktemp "$(dirname "$self")/.peppec.XXXXXX") || die "cannot write in $(dirname "$self")"
  if ! gh api -H "Accept: application/vnd.github.raw" "repos/$ENGINE/contents/cli/peppec?ref=$REF" > "$tmp" 2> /dev/null \
     || ! bash -n "$tmp" 2> /dev/null; then
    rm -f "$tmp"; die "could not download a valid cli/peppec from $ENGINE@$REF"
  fi
  if cmp -s "$tmp" "$self"; then
    rm -f "$tmp"; ok "already up to date with $ENGINE@$REF"
  else
    chmod +x "$tmp"
    # A rename, not an overwrite: bash is still reading the old file
    mv "$tmp" "$self"
    ok "updated to $ENGINE@$REF: $self"
  fi
}

usage() {
  cat << EOF
PEPPEC command line (engine $ENGINE@$REF)

Usage:
  peppec init [--preset <name>] [--key <app.pem>] [--yes]
      Install PEPPEC on the repository of the current clone: labels, settings, control
      panel, variables, secrets, workflow files, branch protection. Safe to run again.
  peppec doctor [-R owner/repo] [--key <app.pem>]
      Check an installation and list what is missing or wrong.
  peppec bot [-R owner/repo]... [--key <app.pem>] [--out <dir>]
      Prepare the folder to copy to the machine that runs the Telegram bot. Repeat -R to
      make one bot follow several repositories that share the app, the bot and the chat.
  peppec update
      Replace this script with the current one of the engine.

Options:
  --ref <ref>   Engine version to install (default: v1)
  --yes         Never ask: keep what is set, take the defaults, read secrets from the
                environment (CLAUDE_CODE_OAUTH_TOKEN, AGENT_TOKEN, TELEGRAM_BOT_TOKEN,
                TELEGRAM_CHAT_ID, PEPPEC_APP_ID, PEPPEC_APP_KEY_FILE)
EOF
}

COMMAND="${1:-}"
[ $# -gt 0 ] && shift
while [ $# -gt 0 ]; do
  case "$1" in
    -R|--repo) REPO="${2:-}"; REPO_LIST="${REPO_LIST:+$REPO_LIST }$REPO"; shift 2;;
    --key) KEY_FILE="${2:-}"; shift 2;;
    --preset) PRESET="${2:-}"; shift 2;;
    --ref) REF="${2:-}"; shift 2;;
    --out) OUT_DIR="${2:-}"; shift 2;;
    -y|--yes) YES=true; shift;;
    -h|--help) usage; exit 0;;
    *) die "unknown option: $1";;
  esac
done
case "$COMMAND" in
  init) cmd_init;;
  doctor) cmd_doctor;;
  bot) cmd_bot;;
  update) cmd_update;;
  ""|help|-h|--help) usage;;
  *) die "unknown command: $COMMAND (try 'peppec help')";;
esac
