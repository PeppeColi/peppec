# Copy to .env next to docker-compose.yml and protect it: chmod 600 .env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_ID=
# The repositories the bot controls, separated by commas: owner/name#N, where N is the
# number of the "Control panel" issue. Example: REPOS=me/shop#1,me/blog#4
# They must share the app, the Telegram bot and the chat.
REPOS=
# Optional: the dashboard, a web page with the state of the queues and the same actions
# as the bot. It is on when DASHBOARD_PASSWORD is set, and it asks for that password.
# DASHBOARD_PORT is the port it answers on in your network: http://<this machine>:8737
# Keep it inside your network, or reach it through a VPN: never expose it to the internet.
# DASHBOARD_PASSWORD=
# DASHBOARD_PORT=8737
